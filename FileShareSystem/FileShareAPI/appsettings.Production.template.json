{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/data/fileshare.db"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "FileShareAPI",
    "Audience": "FileShareUsers",
    "ExpireMinutes": 1440
  },
  "FileStorage": {
    "UploadPath": "/data/uploads",
    "MaxFileSize": 524288000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
