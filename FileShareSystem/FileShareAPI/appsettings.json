{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=fileshare.db"
  },
  "Jwt": {
    "Key": "your-super-secret-jwt-key-that-should-be-at-least-32-characters-long",
    "Issuer": "FileShareAPI",
    "Audience": "FileShareUsers",
    "ExpireMinutes": 1440
  },
  "FileStorage": {
    "UploadPath": "Uploads",
    "MaxFileSize": 524288000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}